<Window x:Class="WPF_UnityInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unity Project Inspector"
        Width="1000"
        Height="700">

    <TabControl>
        <TabItem Header="Dashboard">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32">

                    <TextBlock Text="Unity Project Inspector"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,24" />

                    <Button Content="Select Unity Project"
            Width="180"
            Height="36"
            HorizontalAlignment="Left"
            Click="OnSelectProjectClicked"
            Margin="0,0,0,12" />

                    <TextBlock Text="{Binding ProjectPath}"
               Foreground="Gray"
               TextWrapping="Wrap"
               Margin="0,0,0,24" />

                    <TextBlock Text="{Binding StatusMessage}"
                       Foreground="SteelBlue"
                       Margin="0,20,0,0" />

                    <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Project"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding ProjectName}" />

                        <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Unity Version"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding UnityVersion}" />

                        <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Build Result"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding BuildResult}" />

                        <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Platform"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding Platform}" />

                        <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Artifact Size"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding ArtifactSize}" />

                        <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Build Time"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Text="{Binding BuildTime}" />

                        <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Warnings"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="6"
                           Grid.Column="1"
                           Text="{Binding WarningCount}" />

                        <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Errors"
                           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="7"
                           Grid.Column="1"
                           Text="{Binding ErrorCount}" />

                        <TextBlock Grid.Row="8"
           Grid.Column="0"
           Text="Report Generated"
           FontWeight="SemiBold" />

                        <TextBlock Grid.Row="8"
           Grid.Column="1"
           Text="{Binding ReportGeneratedAt}" />
                    </Grid>

                    <TextBlock Text="Project Storage"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,24,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Disk" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProjectDiskSize}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Project Source" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProjectSourceSize}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Assets" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AssetsSize}" />
                    </Grid>

                    <TextBlock Text="{Binding StorageStatus}"
                               Foreground="Gray"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Asset Type별 Packed Size"
           FontSize="18"
           FontWeight="SemiBold"
           Margin="0,24,0,6" />

                    <TextBlock Text="BuildReport에 기록된 Asset 크기 합계입니다. APK 전체 크기 비율은 아닙니다."
           Foreground="Gray"
           TextWrapping="Wrap"
           Margin="0,0,0,10" />

                    <DataGrid ItemsSource="{Binding AssetTypeSummaries}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          Height="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type"
                            Binding="{Binding Type}"
                            Width="*" />
                            <DataGridTextColumn Header="Assets"
                            Binding="{Binding AssetCount}"
                            Width="100" />
                            <DataGridTextColumn Header="Packed Size (bytes)"
                            Binding="{Binding PackedSizeBytes, StringFormat={}{0:N0}}"
                            Width="170" />
                            <DataGridTextColumn Header="Share (%)"
                            Binding="{Binding SharePercent, StringFormat={}{0:F1}}"
                            Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>



                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Build Analyzer">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
                    <TextBlock Text="검색"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

                    <TextBox Width="300"
                     Text="{Binding AssetSearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,20,0" />

                    <TextBlock Text="Type"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

                    <ComboBox Width="150"
                      ItemsSource="{Binding AssetTypes}"
                      SelectedItem="{Binding SelectedAssetType, Mode=TwoWay}" />
                </StackPanel>

                <DataGrid Grid.Row="1"
                  ItemsSource="{Binding AssetsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="220" />

                        <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type}"
                                    Width="110" />

                        <DataGridTextColumn Header="Packed Size (bytes)"
                                    Binding="{Binding PackedSizeBytes, StringFormat={}{0:N0}}"
                                    SortMemberPath="PackedSizeBytes"
                                    Width="155" />

                        <DataGridTextColumn Header="Path"
                                    Binding="{Binding Path}"
                                    Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Build Messages">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
                    <TextBlock Text="검색"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

                    <TextBox Width="300"
                     Text="{Binding MessageSearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,20,0" />

                    <TextBlock Text="Type"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

                    <ComboBox Width="150"
                      ItemsSource="{Binding MessageTypes}"
                      SelectedItem="{Binding SelectedMessageType, Mode=TwoWay}" />
                </StackPanel>

                <ListBox Grid.Row="1"
         ItemsSource="{Binding MessagesView}"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Type}"
                                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                        <Setter Property="Foreground" Value="DarkOrange" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Error">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
    </TabControl>
</Window>