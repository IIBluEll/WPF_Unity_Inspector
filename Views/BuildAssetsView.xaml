<UserControl x:Class="WPF_UnityInspector.Views.BuildAssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700">
    <UserControl.Resources>
        <Style x:Key="BuildCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#E2E6EB" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="8" />
            <Setter Property="Padding"
                    Value="18" />
        </Style>

        <Style x:Key="BuildSummaryLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Foreground"
                    Value="#667085" />
        </Style>

        <Style x:Key="BuildSummaryValueStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,4,0,0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="#1D2939" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Build Assets"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#101828" />
                <TextBlock Text="빌드에 포함된 Asset의 Packed Size를 검색하고 비교합니다."
                           Margin="0,6,0,0"
                           Foreground="#667085" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="Report Generated"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="#667085" />
                <TextBlock Text="{Binding ReportGeneratedAt}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"
                           Foreground="#344054" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,16">
            <Border Style="{StaticResource BuildCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Build Result"
                               Style="{StaticResource BuildSummaryLabelStyle}" />
                    <TextBlock Text="{Binding BuildResult}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource BuildSummaryValueStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BuildResult}"
                                                 Value="Succeeded">
                                        <Setter Property="Foreground"
                                                Value="#238636" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BuildResult}"
                                                 Value="Failed">
                                        <Setter Property="Foreground"
                                                Value="#C62828" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BuildResult}"
                                                 Value="Cancelled">
                                        <Setter Property="Foreground"
                                                Value="#D97706" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BuildCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Platform"
                               Style="{StaticResource BuildSummaryLabelStyle}" />
                    <TextBlock Text="{Binding Platform}"
                               Style="{StaticResource BuildSummaryValueStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BuildCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Artifact Size"
                               Style="{StaticResource BuildSummaryLabelStyle}" />
                    <TextBlock Text="{Binding ArtifactSize}"
                               Style="{StaticResource BuildSummaryValueStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BuildCardStyle}">
                <StackPanel>
                    <TextBlock Text="Build Time"
                               Style="{StaticResource BuildSummaryLabelStyle}" />
                    <TextBlock Text="{Binding BuildTime}"
                               Style="{StaticResource BuildSummaryValueStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Style="{StaticResource BuildCardStyle}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#475467"
                           FontWeight="SemiBold" />

                <TextBox Grid.Column="1"
                         Height="34"
                         Padding="10,5"
                         VerticalContentAlignment="Center"
                         Text="{Binding AssetSearchText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="3"
                           Text="Type"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#475467"
                           FontWeight="SemiBold" />

                <ComboBox Grid.Column="4"
                          Height="34"
                          Padding="8,4"
                          ItemsSource="{Binding AssetTypes}"
                          SelectedItem="{Binding SelectedAssetType, Mode=TwoWay}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource BuildCardStyle}"
                Padding="0"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding AssetsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      RowHeight="38"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECF0"
                      BorderThickness="0"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height"
                                Value="40" />
                        <Setter Property="Padding"
                                Value="12,0" />
                        <Setter Property="Background"
                                Value="#F9FAFB" />
                        <Setter Property="Foreground"
                                Value="#475467" />
                        <Setter Property="FontWeight"
                                Value="SemiBold" />
                        <Setter Property="BorderBrush"
                                Value="#EAECF0" />
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"
                                Value="12,0" />
                        <Setter Property="BorderThickness"
                                Value="0" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Center" />
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="220" />
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"
                                        Width="110" />
                    <DataGridTextColumn Header="Packed Size (bytes)"
                                        Binding="{Binding PackedSizeBytes, StringFormat={}{0:N0}}"
                                        SortMemberPath="PackedSizeBytes"
                                        Width="170" />
                    <DataGridTextColumn Header="Path"
                                        Binding="{Binding Path}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
