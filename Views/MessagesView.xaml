<UserControl x:Class="WPF_UnityInspector.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700">
    <UserControl.Resources>
        <Style x:Key="MessageCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#E2E6EB" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="8" />
            <Setter Property="Padding"
                    Value="18" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock Text="Build Messages"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#101828" />
            <TextBlock Text="마지막 Build Report에 기록된 Warning과 Error를 확인합니다."
                       Margin="0,6,0,0"
                       Foreground="#667085" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource MessageCardStyle}"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Warnings"
                               FontSize="12"
                               Foreground="#667085" />
                    <TextBlock Text="{Binding WarningCount}"
                               Margin="0,4,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#D97706" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource MessageCardStyle}"
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Errors"
                               FontSize="12"
                               Foreground="#667085" />
                    <TextBlock Text="{Binding ErrorCount}"
                               Margin="0,4,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#C62828" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource MessageCardStyle}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#475467"
                           FontWeight="SemiBold" />

                <TextBox Grid.Column="1"
                         Height="34"
                         Padding="10,5"
                         VerticalContentAlignment="Center"
                         Text="{Binding MessageSearchText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="3"
                           Text="Type"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#475467"
                           FontWeight="SemiBold" />

                <ComboBox Grid.Column="4"
                          Height="34"
                          Padding="8,4"
                          ItemsSource="{Binding MessageTypes}"
                          SelectedItem="{Binding SelectedMessageType, Mode=TwoWay}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource MessageCardStyle}"
                Padding="0"
                ClipToBounds="True">
            <ListBox ItemsSource="{Binding MessagesView}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="MessageRow"
                                            Background="Transparent">
                                        <ContentPresenter />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="MessageRow"
                                                    Property="Background"
                                                    Value="#F9FAFB" />
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter TargetName="MessageRow"
                                                    Property="Background"
                                                    Value="#EEF4FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#EAECF0"
                                BorderThickness="0,0,0,1"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Type}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="#475467" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}"
                                                             Value="Warning">
                                                    <Setter Property="Foreground"
                                                            Value="#D97706" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}"
                                                             Value="Error">
                                                    <Setter Property="Foreground"
                                                            Value="#C62828" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding Message}"
                                           Foreground="#344054"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
