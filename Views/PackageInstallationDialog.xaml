<Window x:Class="WPF_UnityInspector.Views.PackageInstallationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unity 패키지 설치 필요"
        Width="640"
        MinWidth="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F6F8">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Unity Project Inspector 패키지가 필요합니다."
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#101828" />

            <TextBlock Margin="0,8,0,0"
                       Text="Unity Package Manager에서 아래 Git 주소로 패키지를 설치해 주세요."
                       Foreground="#475467"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Text="설치 순서"
                           FontWeight="SemiBold"
                           Foreground="#344054" />

                <TextBlock Margin="0,10,0,0"
                           Text="1. Window &gt; Package Manager&#x0a;2. 왼쪽 위 + 버튼 선택&#x0a;3. Add package from git URL 선택&#x0a;4. 아래 주소를 붙여넣고 설치"
                           Foreground="#475467"
                           LineHeight="22" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="packageUrlTxt"
                             Grid.Column="0"
                             Height="36"
                             Padding="10,7"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             Background="#F9FAFB"
                             BorderBrush="#D0D5DD"
                             Foreground="#344054"
                             HorizontalScrollBarVisibility="Auto" />

                    <Button x:Name="copyUrlBtn"
                            Grid.Column="1"
                            Width="96"
                            Height="36"
                            Margin="8,0,0,0"
                            Content="주소 복사"
                            Background="#3478C9"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnCopyPackageUrlClicked" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,14,0,0"
                   Text="설치 후 Unity 프로젝트를 한 번 빌드해 주세요."
                   Foreground="#667085" />

        <Button Grid.Row="3"
                Width="88"
                Height="34"
                Margin="0,22,0,0"
                HorizontalAlignment="Right"
                Content="확인"
                IsCancel="True" />
    </Grid>
</Window>
